{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/gallery",
      "destination": "/api/gallery/index"
    },
    {
      "source": "/api/admin/media/upload",
      "destination": "/api/admin/media/upload"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}